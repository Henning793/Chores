# Fra Firebase-konsollen: Prosjektinnstillinger → Dine apper → Web-app (</>) → SDK-oppsett
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<prosjekt-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=<prosjekt-id>
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google-innlogging (valgfritt). OAuth-klient-ID-er fra Google Cloud Console → APIs & Services → Credentials.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
